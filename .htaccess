<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Site root: internal rewrite only (no [R]). External redirects to /dashboard/ have caused
    # bad Location headers on some shared hosts (browser ends up under /home3/...).
    RewriteRule ^$ index.php [L,QSA]

    # Real files and directories (assets, existing .php files, sqlite, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Strip trailing slash internally only — never [R] with a bare $1 here: on some hosts that
    # emits a relative Location and the browser stacks it onto the path (e.g. …/home3/…/trytest/…).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ $1 [L]

    # Map /path to /path.php when that script exists (extensionless "pages")
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
